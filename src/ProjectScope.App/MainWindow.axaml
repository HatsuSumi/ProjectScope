<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ProjectScope.App"
        xmlns:media="using:Avalonia.Media"
        x:Class="ProjectScope.App.MainWindow" x:Name="RootWindow" x:DataType="local:MainViewModel"
        Title="ProjectScope" Width="1180" Height="820" MinWidth="860" MinHeight="620"
        Background="{DynamicResource WindowBackgroundBrush}" FontSize="14">
  <Window.Styles>
    <Style Selector="TextBlock.title"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="TextBlock.secondary"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /></Style>
    <Style Selector="Border.theme-menu">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BoxShadow" Value="0 8 24 #55000000" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Button.theme-trigger">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="ThemeTriggerPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" />
          <BrushTransition Property="Foreground" Duration="0:0:0.18" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.theme-trigger:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.config-action">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="ActionPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
            <ContentPresenter.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
              </Transitions>
            </ContentPresenter.Transitions>
          </ContentPresenter>
        </ControlTemplate>
      </Setter>
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.config-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource ReportBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.external-link">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="ActionPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
            <ContentPresenter.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
              </Transitions>
            </ContentPresenter.Transitions>
          </ContentPresenter>
        </ControlTemplate>
      </Setter>
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.external-link:pointerover">
      <Setter Property="Background" Value="{DynamicResource ReportBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.theme-option">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,2*,3*,Auto" Margin="28" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Spacing="4">
        <TextBlock Classes="title" Text="ProjectScope" FontSize="30" FontWeight="Bold" />
        <TextBlock Classes="secondary" Text="了解代码规模，理清项目结构。" />
      </StackPanel>
      <Grid Grid.Column="1" Width="150" VerticalAlignment="Center">
        <Button x:Name="ThemeMenuButton" Classes="theme-trigger" Command="{Binding ToggleThemeMenuCommand}" HorizontalContentAlignment="Stretch" Padding="12,8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ThemePreference.Label}" />
            <Path Grid.Column="1" Data="M 2,4 L 8,10 L 14,4" Stroke="{Binding #ThemeMenuButton.Foreground}" StrokeThickness="1.8" Width="16" Height="14" Stretch="Uniform" RenderTransformOrigin="50%,50%" Margin="12,0,0,0">
              <Path.RenderTransform>
                <RotateTransform Angle="{Binding ThemeMenuArrowAngle}" />
              </Path.RenderTransform>
            </Path>
          </Grid>
        </Button>
        <Popup ShouldUseOverlayLayer="True" IsOpen="{Binding ThemeMenuOpen}" DataContext="{Binding DataContext, ElementName=RootWindow}" Placement="BottomEdgeAlignedLeft" PlacementTarget="{Binding #ThemeMenuButton}" HorizontalOffset="0" VerticalOffset="6">
          <Border x:Name="ThemeMenuPanel" Classes="theme-menu" Opacity="{Binding ThemeMenuOpacity}">
            <Border.RenderTransform>
              <media:TranslateTransform Y="{Binding ThemeMenuOffset}" />
            </Border.RenderTransform>
            <StackPanel>
              <Button Classes="theme-option" Content="跟随系统" Command="{Binding SelectThemeCommand}" CommandParameter="{Binding Source={x:Static local:ThemePreferenceValues.System}}" />
              <Button Classes="theme-option" Content="浅色" Command="{Binding SelectThemeCommand}" CommandParameter="{Binding Source={x:Static local:ThemePreferenceValues.Light}}" />
              <Button Classes="theme-option" Content="深色" Command="{Binding SelectThemeCommand}" CommandParameter="{Binding Source={x:Static local:ThemePreferenceValues.Dark}}" />
              <Button Classes="theme-option" Content="赛博朋克" Command="{Binding SelectThemeCommand}" CommandParameter="{Binding Source={x:Static local:ThemePreferenceValues.Cyberpunk}}" />
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </Grid>
    <Border Grid.Row="1" Classes="card">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" IsEnabled="{Binding CanConfigure}">
          <TextBox Text="{Binding RootPath}" Watermark="项目根目录" />
          <Button Grid.Column="1" Classes="folder-picker" Content="选择文件夹" Click="BrowseClicked" />
          <Button Grid.Column="2" Classes="config-action" Content="保存配置" Command="{Binding SaveConfigurationCommand}" />
          <Button Grid.Column="3" Classes="config-action" Content="加载配置" Click="LoadConfigurationClicked" />
        </Grid>
        <WrapPanel IsEnabled="{Binding CanConfigure}">
          <CheckBox Content="统计资源（统计非代码文件（图片/音频/模型/二进制等））" IsChecked="{Binding IncludeAssets}" Margin="0,0,20,0" />
          <CheckBox Content="包含隐藏文件" IsChecked="{Binding IncludeHidden}" Margin="0,0,20,0" />
          <CheckBox Content="排除空行和注释" IsChecked="{Binding ExcludeBlankLinesAndComments}" Margin="0,0,20,0" />
        </WrapPanel>
        <Expander Header="忽略目录" IsExpanded="True" IsEnabled="{Binding CanConfigure}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <ScrollViewer MaxHeight="90" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding IgnoreDirectories}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:IgnoreDirectoryChoice">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,18,4" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Classes="secondary" Text="勾选目录名会忽略各层级的同名目录；自定义路径每行一条。正则以 regex: 开头，匹配带 / 前缀的项目相对路径。" TextWrapping="Wrap" />
            <TextBox Classes="custom-ignore" Text="{Binding CustomIgnoredPaths, Mode=TwoWay}" AcceptsReturn="True" Height="72" TextWrapping="NoWrap"
                     Watermark="例如：/A/cache/ 或 regex:^/A/(B|C)/example\.xxx$（每行一条）" />
          </StackPanel>
        </Expander>
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
          <Button Classes="primary" Content="开始扫描" Command="{Binding ScanCommand}" />
          <Button Grid.Column="1" Content="取消扫描" Command="{Binding ScanCancelCommand}" />
          <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding Summary}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
      </StackPanel>
      </ScrollViewer>
    </Border>
    <Border Grid.Row="2" Classes="card">
      <Grid RowDefinitions="Auto,*" RowSpacing="14">
        <WrapPanel IsEnabled="{Binding HasResult}">
          <Button Classes="export-action" Content="导出 Markdown" Tag="Markdown" Click="ExportClicked" Margin="0,0,8,0" />
          <Button Classes="export-action" Content="导出 JSON" Tag="Json" Click="ExportClicked" Margin="0,0,8,0" />
          <Button Classes="export-action" Content="导出 TXT" Tag="Text" Click="ExportClicked" Margin="0,0,8,0" />
          <Button Classes="export-action" Content="导出 HTML" Tag="Html" Click="ExportClicked" Margin="0,0,8,0" />
          <Button Classes="export-action" Content="保存目录树" Tag="DirectoryTree" Click="ExportClicked" Margin="0,0,8,0" />
          <Button Classes="export-action" Content="复制目录树" Click="CopyTreeClicked" />
        </WrapPanel>
        <TabControl Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <TabItem Header="统计报告"><TextBox Classes="report" Text="{Binding Report}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" /></TabItem>
          <TabItem Header="目录树"><TextBox Classes="report" Text="{Binding DirectoryTree}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" /></TabItem>
          <TabItem Header="文件清单"><TextBox Classes="report" Text="{Binding FileList}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" /></TabItem>
          <TabItem Header="细分统计"><TextBox Classes="report" Text="{Binding Details}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" /></TabItem>
          <TabItem Header="扫描日志"><TextBox Classes="report" Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" /></TabItem>
          <TabItem Header="关于">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="18" Margin="20" MaxWidth="900" HorizontalAlignment="Left">
                <StackPanel Spacing="8">
                  <TextBlock Classes="title" Text="关于 ProjectScope" FontSize="24" FontWeight="Bold" />
                  <TextBlock Text="这是一个由一人在孤独和抑郁症下开发完成的开源免费项目。" TextWrapping="Wrap" />
                  <TextBlock Text="跨平台桌面项目统计工具，用于分析项目文件、代码规模、资源占用和目录结构，并生成清晰易读的统计报告。" TextWrapping="Wrap" />
                  <Button Classes="external-link" HorizontalAlignment="Left" Content="打开 GitHub 仓库" Click="GitHubClicked" />
                  <TextBlock Classes="secondary" Text="项目仓库：github.com/HatsuSumi/ProjectScope" TextWrapping="Wrap" />
                  <Button Classes="external-link" HorizontalAlignment="Left" Content="打开个人网站" Click="PortfolioClicked" />
                  <TextBlock Classes="secondary" Text="了解作者的作品与开发记录。" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Classes="title" Text="核心能力" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="递归扫描与进度显示 · 代码和资源分类统计 · 自定义忽略规则 · 扫描配置保存与加载 · Markdown、JSON、TXT 和 HTML 报告导出 · 完全离线的 HTML 图表报告" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Classes="title" Text="技术栈" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="C# · .NET 8 · Avalonia UI · MVVM · CommunityToolkit.Mvvm · System.Text.Json · ECharts 5.4.3" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Classes="title" Text="项目结构" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Classes="report" Text="ProjectScope/&#10;├── README.md&#10;├── ProjectScope.sln&#10;├── Directory.Build.props&#10;├── Directory.Packages.props&#10;├── vendor/&#10;│   └── echarts.min.js                 离线 HTML 报告使用的图表运行时&#10;└── src/&#10;    ├── ProjectScope.App/             Avalonia 桌面应用与 MVVM 界面&#10;    ├── ProjectScope.Core/            统计模型、类型识别、注释处理与目录树&#10;    ├── ProjectScope.Infrastructure/  文件扫描、配置存储与报告导出&#10;    └── ProjectScope.Tests/           核心统计、扫描和配置测试" TextWrapping="NoWrap" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Classes="title" Text="项目规模" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="文件统计" FontWeight="SemiBold" />
                  <TextBlock Text="总文件数：27 个&#10;  C#文件：15 个&#10;  XML文件：2 个&#10;  JavaScript文件：1 个&#10;  Markdown文档：1 个&#10;  其他文件：8 个" />
                  <TextBlock Text="代码规模" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <TextBlock Text="代码总行数：1,873 行（不含空行、注释）&#10;  C#：1,510 行（80.6%）&#10;  XML：351 行（18.7%）&#10;  JavaScript：12 行（0.7%）&#10;&#10;字符总数：1,132,212 字符（不含注释）&#10;  C#：86,530 字符（7.6%）&#10;  XML：23,307 字符（2.1%）&#10;  JavaScript：1,022,375 字符（90.3%）" TextWrapping="Wrap" />
                  <TextBlock Text="资源文件" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <TextBlock Text="资源文件总数：0 个&#10;资源文件总大小：0 B" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>
    <TextBlock Grid.Row="3" Classes="secondary" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
  </Grid>
</Window>
