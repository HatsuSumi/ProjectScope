<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ProjectScope.App"
             x:Class="ProjectScope.App.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.folder-picker /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.report">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
            <Setter Property="Background" Value="{DynamicResource ReportBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F5FA" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E6F0" />
                    <SolidColorBrush x:Key="ReportBackgroundBrush" Color="#FAFBFE" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#25304A" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#65718C" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#365CE6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111827" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1B2435" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#334155" />
                    <SolidColorBrush x:Key="ReportBackgroundBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAB8CC" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#6D8BFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static local:App.CyberpunkTheme}">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#090B16" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#11152A" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF2BD6" />
                    <SolidColorBrush x:Key="ReportBackgroundBrush" Color="#070A12" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8F7FF" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#80D9E8" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#00E5FF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
